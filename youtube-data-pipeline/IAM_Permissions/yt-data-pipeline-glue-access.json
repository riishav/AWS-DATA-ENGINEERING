{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "S3FullAccess",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:ListBucket",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::yt-data-bronze-dev/*",
                "arn:aws:s3:::yt-data-bronze-dev",
                "arn:aws:s3:::yt-data-silver-dev/*",
                "arn:aws:s3:::yt-data-silver-dev",
                "arn:aws:s3:::yt-data-gold-dev/*",
                "arn:aws:s3:::yt-data-gold-dev",
                "arn:aws:s3:::yt-data-pipeline-all-script/*",
                "arn:aws:s3:::yt-data-pipeline-all-script"
            ]
        }
    ]
}